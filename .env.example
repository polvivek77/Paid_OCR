# Copy to .env and fill in. .env is git-ignored.

# --- API keys (required for the cloud engines) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Optional model overrides (defaults shown) ---
# OPENAI_MODEL=gpt-6-astra
# ANTHROPIC_MODEL=claude-opus-5-5
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_THINKING=disabled    # "enabled" turns on reasoning (slow; can use the whole token limit and return nothing)

# --- Optional tuning for all cloud engines ---
# LLM_OCR_CONCURRENCY=4         # pages sent in parallel per engine
# LLM_OCR_MAX_IMAGE_SIDE=2048   # longest side (px) of each page image sent
# LLM_OCR_MAX_TOKENS=16000      # max output tokens per page
